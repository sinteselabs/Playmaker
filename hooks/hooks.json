{
  "description": "Playmaker: the nudge, CLI detection, and the live board pane",
  "modules": [
    "./panel.js"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/detect-agents.mjs",
              "--hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "TaskCreate|TaskUpdate|TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/task-watch.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
