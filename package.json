    ".claude-plugin/",
    "cli/",
    "hooks/",
    "monitors/",
    "scripts/",
    "skills/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node tests/cli.mjs",
    "test:e2e": "node tests/board.mjs && node tests/smoke.mjs && node tests/commands.mjs && node tests/memory.mjs"
  },
  "author": "Síntese Labs",
  "homepage": "https://github.com/sinteselabs/Playmaker#readme",
